### @name="get all products"
GET http://localhost:8080/api/products
Accept: application/json


### @name="get product by id"
GET http://localhost:8080/api/products/3
Accept: application/json

### name = "get by range"
GET http://localhost:8080/api/products?low=500&high=25000
Accept: application/json


### @name="add a new Product"
POST http://localhost:8080/api/products
Accept: application/json
Content-Type: application/json

{
  "name": "LG AC",
  "price": 45000.00,
  "quantity": 100
}


### @name="add invalid Product"
POST http://localhost:8080/api/products
Accept: application/json
Content-Type: application/json
Accept-Language: fr-FR

{
  "name": "",
  "price": 3.00,
  "quantity": 0
}

### @name="update product price"
PATCH http://localhost:8080/api/products/3?price=5350
Accept: application/json


### @name="Etag request"
GET http://localhost:8080/api/products/etag/3
Accept: application/json

### @name="Etag request cached"
GET http://localhost:8080/api/products/etag/3
Accept: application/json
If-None-Match: "-511349071"


### @name="Etag request"
GET http://localhost:8080/api/products/cache/3
Accept: application/json
